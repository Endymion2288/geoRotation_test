diff --git a/Tracking/Acts/FaserActsKalmanFilter/test/CandidateIsolatedSmoothing_test.cxx b/Tracking/Acts/FaserActsKalmanFilter/test/CandidateIsolatedSmoothing_test.cxx
new file mode 100644
index 00000000..1e096746
--- /dev/null
+++ b/Tracking/Acts/FaserActsKalmanFilter/test/CandidateIsolatedSmoothing_test.cxx
@@ -0,0 +1,189 @@
+// Exercise the ACTS state containers and RTS smoother used by CKF2.
+#include "Acts/EventData/TrackContainer.hpp"
+#include "Acts/EventData/VectorMultiTrajectory.hpp"
+#include "Acts/EventData/VectorTrackContainer.hpp"
+#include "Acts/Surfaces/PlaneSurface.hpp"
+#include "Acts/TrackFitting/GainMatrixSmoother.hpp"
+
+#include <array>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+using Tracks = Acts::TrackContainer<Acts::VectorTrackContainer,
+                                    Acts::VectorMultiTrajectory>;
+
+void require(bool condition, const char* message) {
+  if (!condition) throw std::runtime_error(message);
+}
+
+struct State {
+  Acts::BoundVector predicted, filtered, smoothed;
+  Acts::BoundMatrix predictedCovariance, filteredCovariance, smoothedCovariance;
+  Acts::BoundMatrix jacobian;
+};
+
+std::vector<State> snapshot(const Tracks::TrackProxy& track) {
+  std::vector<State> states;
+  for (const auto state : track.trackStatesReversed()) {
+    states.push_back({state.predicted(), state.filtered(), state.smoothed(),
+                      state.predictedCovariance(), state.filteredCovariance(),
+                      state.smoothedCovariance(), state.jacobian()});
+  }
+  return states;
+}
+
+void checkEqual(const std::vector<State>& a, const std::vector<State>& b,
+                bool checkSmoothed) {
+  require(a.size() == b.size(), "State count changed");
+  for (std::size_t i = 0; i < a.size(); ++i) {
+    require(a[i].predicted == b[i].predicted &&
+                a[i].filtered == b[i].filtered &&
+                a[i].predictedCovariance == b[i].predictedCovariance &&
+                a[i].filteredCovariance == b[i].filteredCovariance &&
+                a[i].jacobian == b[i].jacobian,
+            "Smoothing changed filtering inputs");
+    if (checkSmoothed) {
+      require(a[i].smoothed == b[i].smoothed &&
+                  a[i].smoothedCovariance == b[i].smoothedCovariance,
+              "Another candidate changed saved smoothed values");
+    }
+  }
+}
+
+void run() {
+  const Acts::GeometryContext gctx;
+  const auto logger = Acts::getDefaultLogger("CandidateSmoothingTest",
+                                            Acts::Logging::WARNING);
+  const auto surface = Acts::Surface::makeShared<Acts::PlaneSurface>(
+      Acts::Transform3::Identity());
+  Acts::BoundVector base = Acts::BoundVector::Zero();
+  base[Acts::eBoundPhi] = 0.1;
+  base[Acts::eBoundTheta] = 1.0;
+  base[Acts::eBoundQOverP] = 0.001;
+
+  Acts::VectorTrackContainer backend;
+  Acts::VectorMultiTrajectory states;
+  Tracks source(backend, states);
+  const auto mask = Acts::TrackStatePropMask::Predicted |
+                    Acts::TrackStatePropMask::Filtered |
+                    Acts::TrackStatePropMask::Smoothed |
+                    Acts::TrackStatePropMask::Jacobian;
+  auto append = [&](auto track, const Acts::BoundVector& filtered,
+                    double variance) {
+    auto state = track.appendTrackState(mask);
+    state.setReferenceSurface(surface);
+    state.predicted() = base;
+    state.predictedCovariance() = 2.0 * Acts::BoundMatrix::Identity();
+    state.filtered() = filtered;
+    state.filteredCovariance() = variance * Acts::BoundMatrix::Identity();
+    state.smoothed().setZero();
+    state.smoothedCovariance().setZero();
+    state.jacobian().setIdentity();
+    state.typeFlags().set(Acts::TrackStateFlag::MeasurementFlag);
+    return state.index();
+  };
+  auto a = source.getTrack(source.addTrack());
+  append(a, base, 1.0);
+  const auto prefixTip = append(a, base, 1.0);
+  Acts::BoundVector endA = base, endB = base;
+  endA[Acts::eBoundLoc0] = 2.0;
+  endA[Acts::eBoundQOverP] = 0.002;
+  endB[Acts::eBoundLoc0] = -3.0;
+  endB[Acts::eBoundQOverP] = 0.0005;
+  append(a, endA, 0.4);
+  auto b = source.getTrack(source.addTrack());
+  b.tipIndex() = prefixTip;
+  append(b, endB, 0.8);
+  for (auto track : source) {
+    track.parameters() = base;
+    track.covariance().setIdentity();
+    track.nMeasurements() = 3;
+    track.setReferenceSurface(surface);
+  }
+  auto smooth = [&](Tracks& tracks, auto track) {
+    const auto status = Acts::GainMatrixSmoother()(
+        gctx, tracks.trackStateContainer(), track.tipIndex(), *logger);
+    require(status.ok(), "ACTS smoother failed");
+  };
+
+  // Reproduce the ownership bug: B overwrites both of A's shared ancestors.
+  smooth(source, a);
+  const auto correctA = snapshot(a);
+  smooth(source, b);
+  const auto contaminatedA = snapshot(a);
+  require(!correctA.back().smoothed.isApprox(contaminatedA.back().smoothed),
+          "Fixture did not reproduce shared parameter overwrite");
+  require(!correctA.back().smoothedCovariance.isApprox(
+              contaminatedA.back().smoothedCovariance),
+          "Fixture did not reproduce shared covariance overwrite");
+  const auto correctB = snapshot(b);
+
+  // CKF2's repair: deep-copy selected paths, then recompute their smoothing.
+  // Repeat in both candidate orders, including within one destination backend.
+  for (const bool reverse : {false, true}) {
+    Acts::VectorTrackContainer outputBackend;
+    Acts::VectorMultiTrajectory outputStates;
+    Tracks output(outputBackend, outputStates);
+    std::array<std::vector<State>, 2> saved;
+    for (unsigned int step = 0; step < 2; ++step) {
+      const unsigned int candidate = reverse ? 1 - step : step;
+      auto input = source.getTrack(candidate);
+      auto copied = output.getTrack(output.addTrack());
+      copied.copyFrom(input, true);
+      const auto before = snapshot(copied);
+      checkEqual(before, snapshot(input), true);
+      smooth(output, copied);
+      const auto after = snapshot(copied);
+      checkEqual(before, after, false);
+      checkEqual(after, candidate == 0 ? correctA : correctB, true);
+      // For identity transport, the two backward gains are both 1/2.
+      const auto& end = candidate == 0 ? endA : endB;
+      const double variance = candidate == 0 ? 0.4 : 0.8;
+      require(after.back().smoothed.isApprox(base + 0.25 * (end - base)),
+              "Incorrect candidate-specific RTS parameters");
+      require(after.back().smoothedCovariance.isApprox(
+                  (0.625 + 0.0625 * variance) * Acts::BoundMatrix::Identity()),
+              "Incorrect candidate-specific RTS covariance");
+      require(copied.nMeasurements() == input.nMeasurements() &&
+                  copied.parameters() == input.parameters() &&
+                  copied.covariance() == input.covariance(),
+              "Track metadata or reference-surface parameters changed");
+      for (const auto state : copied.trackStatesReversed()) {
+        require(state.typeFlags().test(Acts::TrackStateFlag::MeasurementFlag) &&
+                    &state.referenceSurface() == surface.get(),
+                "Measurement flags or surfaces changed");
+      }
+      saved[step] = after;
+      if (step == 1) checkEqual(saved[0], snapshot(output.getTrack(0)), true);
+      checkEqual(contaminatedA, snapshot(a), true);
+      checkEqual(correctB, snapshot(b), true);
+    }
+  }
+
+  // A one-state candidate must keep its filtered mean and covariance exactly.
+  Acts::VectorTrackContainer singleBackend;
+  Acts::VectorMultiTrajectory singleStates;
+  Tracks single(singleBackend, singleStates);
+  auto one = single.getTrack(single.addTrack());
+  append(one, endA, 0.4);
+  smooth(single, one);
+  const auto only = snapshot(one).front();
+  require(only.smoothed == only.filtered &&
+              only.smoothedCovariance == only.filteredCovariance,
+          "One-state smoothing changed the endpoint");
+}
+}  // namespace
+
+int main() {
+  try {
+    run();
+    std::cout << "Shared overwrite reproduced; isolated parameters/covariance, "
+                 "candidate order, unchanged inputs and single-state case passed\n";
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
-- 
2.52.0



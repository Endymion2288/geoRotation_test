index 4ecf14a4..149eb02e 100644
--- a/Tracking/Acts/FaserActsKalmanFilter/src/TrackFitterFunction.cxx
+++ b/Tracking/Acts/FaserActsKalmanFilter/src/TrackFitterFunction.cxx
@@ -1,5 +1,87 @@
 #include "TrackFitterFunction.h"
 #include "TrackerRIO_OnTrack/FaserSCT_ClusterOnTrack.h"
+#include "Acts/Utilities/detail/periodic.hpp"
+#include <cmath>
+
+// Diagnostic adapter: retain the actual ACTS 32.0.2 smoother calculation and
+// covariance update, changing only its phi subtraction to the periodic one.
+struct PhiPeriodicGainMatrixSmoother {
+  bool wrapPhi = false;
+  bool canonicalAngles = false;
+  static void canonicalize(Acts::VectorMultiTrajectory::TrackStateProxy& state) {
+    const double phi = state.smoothed()[Acts::eBoundPhi];
+    const double theta = state.smoothed()[Acts::eBoundTheta];
+    const auto normalized = Acts::detail::normalizePhiTheta(phi, theta);
+    state.smoothed()[Acts::eBoundPhi] = normalized.first;
+    state.smoothed()[Acts::eBoundTheta] = normalized.second;
+    // The equivalent angular chart preserves the physical direction. Its
+    // theta derivative changes sign when the direction crosses either pole.
+    if (std::sin(theta) < 0.) {
+      state.smoothedCovariance().row(Acts::eBoundTheta) *= -1.;
+      state.smoothedCovariance().col(Acts::eBoundTheta) *= -1.;
+    }
+  }
+  Acts::Result<void> operator()(const Acts::GeometryContext&,
+      Acts::VectorMultiTrajectory& trajectory, std::size_t entryIndex,
+      const Acts::Logger& logger) const {
+    using Proxy = Acts::VectorMultiTrajectory::TrackStateProxy;
+    Acts::GainMatrixSmoother native;
+    Acts::GainMatrixSmoother::GetParameters filtered, smoothed, predicted;
+    Acts::GainMatrixSmoother::GetCovariance filteredCovariance,
+        predictedCovariance, smoothedCovariance, jacobian;
+    filtered.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->filtered();
+    });
+    smoothed.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->smoothed();
+    });
+    predicted.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->predicted();
+    });
+    filteredCovariance.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->filteredCovariance();
+    });
+    predictedCovariance.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->predictedCovariance();
+    });
+    smoothedCovariance.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->smoothedCovariance();
+    });
+    jacobian.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->jacobian();
+    });
+    auto previous = trajectory.getTrackState(entryIndex);
+    previous.smoothed() = previous.filtered();
+    previous.smoothedCovariance() = previous.filteredCovariance();
+    if (canonicalAngles) canonicalize(previous);
+    if (!previous.hasPrevious()) return Acts::Result<void>::success();
+    std::error_code error;
+    trajectory.applyBackwards(previous.previous(), [&](auto state) {
+      const double originalPhi = previous.smoothed()[Acts::eBoundPhi];
+      const double predictedPhi = previous.predicted()[Acts::eBoundPhi];
+      // The temporary 2*pi shift leaves the previous state's direction and
+      // covariance unchanged. Restore its stored chart after the native call.
+      if (wrapPhi) {
+        previous.smoothed()[Acts::eBoundPhi] = predictedPhi +
+            Acts::detail::difference_periodic(originalPhi, predictedPhi,
+                                               2. * std::acos(-1.));
+      }
+      auto status = native.calculate(&state, &previous, filtered,
+          filteredCovariance, smoothed, predicted, predictedCovariance,
+          smoothedCovariance, jacobian, logger);
+      previous.smoothed()[Acts::eBoundPhi] = originalPhi;
+      if (!status.ok()) {
+        error = status.error();
+        return false;
+      }
+      if (canonicalAngles) canonicalize(state);
+      previous = state;
+      return true;
+    });
+    return error ? Acts::Result<void>::failure(error)
+                 : Acts::Result<void>::success();
+  }
+};
 

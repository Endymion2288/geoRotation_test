--- a/Tracking/Acts/FaserActsKalmanFilter/src/CreateTrkTrackTool.cxx
+++ b/Tracking/Acts/FaserActsKalmanFilter/src/CreateTrkTrackTool.cxx
@@ -123,5 +123,15 @@ CreateTrkTrackTool::ConvertActsTrackParameterToATLAS(const Acts::BoundTrackParam
   double p = std::abs(1. / tqOverP);
   Amg::Vector3D tmom(p * std::cos(tphi) * std::sin(ttheta), p * std::sin(tphi) * std::sin(ttheta), p * std::cos(ttheta));
   double charge = tqOverP > 0. ? 1. : -1.;
+  if (m_correctCovarianceBasis && cov) {
+    Trk::CurvilinearParameters frame(pos, tmom, charge);
+    const Eigen::Matrix<double, 3, 2> outputBasis =
+        frame.associatedSurface().transform().rotation().leftCols<2>();
+    const Eigen::Matrix<double, 3, 2> inputBasis =
+        actsParameter.referenceSurface().transform(gctx).rotation().leftCols<2>();
+    AmgMatrix(5,5) jacobian = AmgMatrix(5,5)::Identity();
+    jacobian.topLeftCorner<2,2>() = outputBasis.transpose() * inputBasis;
+    cov = (jacobian * (*cov) * jacobian.transpose()).eval();
+  }
   return std::make_unique<Trk::CurvilinearParameters>(pos,tmom,charge, cov);
 }

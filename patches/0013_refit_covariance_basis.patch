@@ -358,6 +358,9 @@ KalmanFitterTool::fit(const EventContext &ctx, const Acts::GeometryContext &gctx
 
   // set the start position 10 mm in front of the first track measurement
   double origin = inputTrack->trackParameters()->front()->position().z() - 10;
+  if (m_useInputReferencePlane) {
+    origin = inputTrack->trackParameters()->front()->position().z();
+  }
 
   auto pSurface = Acts::Surface::makeShared<Acts::PlaneSurface>(
       Acts::Vector3 {0, 0, origin}, Acts::Vector3{0, 0, -1});
@@ -592,6 +595,23 @@ KalmanFitterTool::getParametersFromTrack(const Trk::TrackParameters *inputParame
   for(int i=0; i < cov.cols(); i++){
     cov(4, i) = cov(4, i)/1_MeV;
   }
+  if (m_correctCovarianceBasis) {
+    // Re-express position uncertainty at the nominal input point. The separate
+    // UseInputReferencePlane control determines whether the native 10 mm mean
+    // displacement remains; this basis change does not propagate that shift.
+    const Acts::RotationMatrix3 planeBasis =
+        pSurface->transform(Acts::GeometryContext{}).rotation();
+    const Acts::Vector3 normal = planeBasis.col(2);
+    const Acts::Vector3 direction = inputParameters->momentum().normalized();
+    const Eigen::Matrix<double, 3, 2> inputBasis =
+        inputParameters->associatedSurface().transform().rotation().leftCols<2>();
+    const Acts::SquareMatrix3 projection = Acts::SquareMatrix3::Identity()
+        - direction * normal.transpose() / normal.dot(direction);
+    Acts::BoundSquareMatrix jacobian = Acts::BoundSquareMatrix::Identity();
+    jacobian.topLeftCorner<2,2>() =
+        planeBasis.leftCols<2>().transpose() * projection * inputBasis;
+    cov = (jacobian * cov * jacobian.transpose()).eval();
+  }
   for (int i = 0; i < 6; ++i) {
     cov(i,i) = m_seedCovarianceScale * cov(i,i);
   }

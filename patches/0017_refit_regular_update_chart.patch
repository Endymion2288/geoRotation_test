diff --git a/Tracking/Acts/FaserActsKalmanFilter/src/RefitDirectionChart.h b/Tracking/Acts/FaserActsKalmanFilter/src/RefitDirectionChart.h
new file mode 100644
index 00000000..d1e3613f
--- /dev/null
+++ b/Tracking/Acts/FaserActsKalmanFilter/src/RefitDirectionChart.h
@@ -0,0 +1,44 @@
+#ifndef FASER_REFIT_DIRECTION_CHART_H
+#define FASER_REFIT_DIRECTION_CHART_H
+
+#include "Acts/Definitions/Algebra.hpp"
+#include "Acts/Definitions/TrackParametrization.hpp"
+#include <cmath>
+#include <utility>
+
+inline std::pair<Acts::BoundVector, Acts::BoundSquareMatrix> refitDirectionChart(
+      const Acts::BoundVector& input, bool inverse = false) {
+    const double phi = input[Acts::eBoundPhi];
+    // Native input uses polar theta. The regular chart uses latitude around
+    // zero, avoiding a subtraction from pi/2 when converting tiny slopes back.
+    const double theta = input[Acts::eBoundTheta];
+    const double sp = std::sin(phi), cp = std::cos(phi);
+    const double st = std::sin(theta), ct = std::cos(theta);
+    Acts::SquareMatrix3 rotation;
+    rotation << 0., 0., 1., 0., 1., 0., -1., 0., 0.;
+    if (inverse) rotation.transposeInPlace();
+    const Acts::Vector3 direction = rotation * (inverse
+        ? Acts::Vector3(cp*ct, sp*ct, st)
+        : Acts::Vector3(cp*st, sp*st, ct));
+    const double transverse2 = direction.x()*direction.x() + direction.y()*direction.y();
+    const double transverse = std::sqrt(transverse2);
+    Acts::BoundVector output = input;
+    output[Acts::eBoundPhi] = std::atan2(direction.y(), direction.x());
+    output[Acts::eBoundTheta] = inverse ? std::atan2(transverse, direction.z())
+                                      : std::atan2(direction.z(), transverse);
+    Eigen::Matrix<double, 3, 2> derivatives;
+    derivatives.col(0) = rotation * (inverse
+        ? Acts::Vector3(-sp*ct, cp*ct, 0.) : Acts::Vector3(-sp*st, cp*st, 0.));
+    derivatives.col(1) = rotation * (inverse
+        ? Acts::Vector3(-cp*st, -sp*st, ct) : Acts::Vector3(cp*ct, sp*ct, -st));
+    Eigen::Matrix<double, 2, 3> angleGradient;
+    angleGradient.row(0) << -direction.y()/transverse2, direction.x()/transverse2, 0.;
+    angleGradient.row(1) << direction.x()*direction.z()/transverse,
+                            direction.y()*direction.z()/transverse, -transverse;
+    if (!inverse) angleGradient.row(1) *= -1.;
+    Acts::BoundSquareMatrix jacobian = Acts::BoundSquareMatrix::Identity();
+    jacobian.block<2, 2>(Acts::eBoundPhi, Acts::eBoundPhi) = angleGradient * derivatives;
+    return {output, jacobian};
+  }
+
+#endif
diff --git a/Tracking/Acts/FaserActsKalmanFilter/src/TrackFitterFunction.cxx b/Tracking/Acts/FaserActsKalmanFilter/src/TrackFitterFunction.cxx
index 4ecf14a4..f08b57cf 100644
--- a/Tracking/Acts/FaserActsKalmanFilter/src/TrackFitterFunction.cxx
+++ b/Tracking/Acts/FaserActsKalmanFilter/src/TrackFitterFunction.cxx
@@ -1,5 +1,221 @@
 #include "TrackFitterFunction.h"
 #include "TrackerRIO_OnTrack/FaserSCT_ClusterOnTrack.h"
+#include "Acts/Utilities/detail/periodic.hpp"
+#include <cmath>
+#include "RefitDirectionChart.h"
+
+// Direction-chart control inside the real Calypso fitter. Local surface
+// coordinates, measurements and forward propagation remain in the native
+// geometry. Only the backward algebra uses (phi_A,latitude_A), where
+// (x_A,y_A,z_A)=(z_F,y_F,-x_F), away from the forward-beam polar singularity.
+struct RegularDirectionGainMatrixSmoother {
+  struct Buffer {
+    Acts::BoundVector filtered = Acts::BoundVector::Zero();
+    Acts::BoundVector predicted = Acts::BoundVector::Zero();
+    Acts::BoundVector smoothed = Acts::BoundVector::Zero();
+    Acts::BoundSquareMatrix filteredCovariance = Acts::BoundSquareMatrix::Zero();
+    Acts::BoundSquareMatrix predictedCovariance = Acts::BoundSquareMatrix::Zero();
+    Acts::BoundSquareMatrix smoothedCovariance = Acts::BoundSquareMatrix::Zero();
+    Acts::BoundSquareMatrix jacobian = Acts::BoundSquareMatrix::Zero();
+  };
+
+
+  Acts::Result<void> operator()(const Acts::GeometryContext&,
+      Acts::VectorMultiTrajectory& trajectory, std::size_t entryIndex,
+      const Acts::Logger& logger) const {
+    Acts::GainMatrixSmoother native;
+    Acts::GainMatrixSmoother::GetParameters filtered, smoothed, predicted;
+    Acts::GainMatrixSmoother::GetCovariance filteredCovariance,
+        predictedCovariance, smoothedCovariance, jacobian;
+    filtered.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundVector>(static_cast<Buffer*>(state)->filtered.data());
+    });
+    predicted.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundVector>(static_cast<Buffer*>(state)->predicted.data());
+    });
+    smoothed.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundVector>(static_cast<Buffer*>(state)->smoothed.data());
+    });
+    filteredCovariance.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundSquareMatrix>(static_cast<Buffer*>(state)->filteredCovariance.data());
+    });
+    predictedCovariance.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundSquareMatrix>(static_cast<Buffer*>(state)->predictedCovariance.data());
+    });
+    smoothedCovariance.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundSquareMatrix>(static_cast<Buffer*>(state)->smoothedCovariance.data());
+    });
+    jacobian.connect([](const void*, void* state) {
+      return Eigen::Map<Acts::BoundSquareMatrix>(static_cast<Buffer*>(state)->jacobian.data());
+    });
+    auto previous = trajectory.getTrackState(entryIndex);
+    previous.smoothed() = previous.filtered();
+    previous.smoothedCovariance() = previous.filteredCovariance();
+    if (!previous.hasPrevious()) return Acts::Result<void>::success();
+    std::error_code error;
+    trajectory.applyBackwards(previous.previous(), [&](auto state) {
+      Buffer current, next;
+      const auto [filteredMean, jf] = refitDirectionChart(state.filtered());
+      const auto [predictedMean, jp] = refitDirectionChart(previous.predicted());
+      const auto [smoothedMean, js] = refitDirectionChart(previous.smoothed());
+      current.filtered = filteredMean;
+      current.filteredCovariance = jf * state.filteredCovariance() * jf.transpose();
+      next.predicted = predictedMean;
+      next.predictedCovariance = jp * previous.predictedCovariance() * jp.transpose();
+      next.smoothed = smoothedMean;
+      next.smoothed[Acts::eBoundPhi] = predictedMean[Acts::eBoundPhi] +
+          Acts::detail::difference_periodic(smoothedMean[Acts::eBoundPhi],
+              predictedMean[Acts::eBoundPhi], 2.*std::acos(-1.));
+      next.smoothedCovariance = js * previous.smoothedCovariance() * js.transpose();
+      // Both ends of the actual stored transport derivative change chart.
+      next.jacobian = jp * previous.jacobian() * jf.inverse();
+      auto status = native.calculate(&current, &next, filtered,
+          filteredCovariance, smoothed, predicted, predictedCovariance,
+          smoothedCovariance, jacobian, logger);
+      if (!status.ok()) {
+        error = status.error();
+        return false;
+      }
+      const auto [nativeMean, back] = refitDirectionChart(current.smoothed, true);
+      state.smoothed() = nativeMean;
+      state.smoothedCovariance() = back * current.smoothedCovariance * back.transpose();
+      previous = state;
+      return true;
+    });
+    return error ? Acts::Result<void>::failure(error)
+                 : Acts::Result<void>::success();
+  }
+};
+
+// Use the same measured local coordinates and native ACTS measurement update,
+// changing the direction chart before its linear Gaussian algebra. Restore
+// the predicted slots so all saved states and transport Jacobians remain in
+// the native chart. Only filtered output is passed to subsequent transport.
+struct RegularDirectionGainMatrixUpdater {
+  Acts::Result<void> operator()(const Acts::GeometryContext& gctx,
+      Acts::VectorMultiTrajectory::TrackStateProxy state,
+      Acts::Direction direction, const Acts::Logger& logger) const {
+    const Acts::BoundVector predicted = state.predicted();
+    const Acts::BoundSquareMatrix covariance = state.predictedCovariance();
+    const auto [regularMean, jacobian] = refitDirectionChart(predicted);
+    state.predicted() = regularMean;
+    state.predictedCovariance() = jacobian * covariance * jacobian.transpose();
+    Acts::GainMatrixUpdater native;
+    auto status = native.operator()<Acts::VectorMultiTrajectory>(
+        gctx, state, direction, logger);
+    state.predicted() = predicted;
+    state.predictedCovariance() = covariance;
+    if (!status.ok()) return status;
+    const auto [nativeMean, inverse] = refitDirectionChart(state.filtered(), true);
+    const Acts::BoundSquareMatrix regularCovariance = state.filteredCovariance();
+    state.filtered() = nativeMean;
+    state.filteredCovariance() = inverse * regularCovariance * inverse.transpose();
+    return status;
+  }
+};
+
+// Keep the native ACTS update and its chi2. Re-express its output mean and
+// covariance in the canonical angular chart before subsequent transport.
+struct CanonicalGainMatrixUpdater {
+  Acts::Result<void> operator()(const Acts::GeometryContext& gctx,
+      Acts::VectorMultiTrajectory::TrackStateProxy state,
+      Acts::Direction direction, const Acts::Logger& logger) const {
+    Acts::GainMatrixUpdater native;
+    auto status = native.operator()<Acts::VectorMultiTrajectory>(
+        gctx, state, direction, logger);
+    if (!status.ok()) return status;
+    const double phi = state.filtered()[Acts::eBoundPhi];
+    const double theta = state.filtered()[Acts::eBoundTheta];
+    const auto normalized = Acts::detail::normalizePhiTheta(phi, theta);
+    state.filtered()[Acts::eBoundPhi] = normalized.first;
+    state.filtered()[Acts::eBoundTheta] = normalized.second;
+    if (std::sin(theta) < 0.) {
+      state.filteredCovariance().row(Acts::eBoundTheta) *= -1.;
+      state.filteredCovariance().col(Acts::eBoundTheta) *= -1.;
+    }
+    return status;
+  }
+};
+
+// Diagnostic adapter: retain the actual ACTS 32.0.2 smoother calculation and
+// covariance update, changing only its phi subtraction to the periodic one.
+struct PhiPeriodicGainMatrixSmoother {
+  bool wrapPhi = false;
+  bool canonicalAngles = false;
+  static void canonicalize(Acts::VectorMultiTrajectory::TrackStateProxy& state) {
+    const double phi = state.smoothed()[Acts::eBoundPhi];
+    const double theta = state.smoothed()[Acts::eBoundTheta];
+    const auto normalized = Acts::detail::normalizePhiTheta(phi, theta);
+    state.smoothed()[Acts::eBoundPhi] = normalized.first;
+    state.smoothed()[Acts::eBoundTheta] = normalized.second;
+    // The equivalent angular chart preserves the physical direction. Its
+    // theta derivative changes sign when the direction crosses either pole.
+    if (std::sin(theta) < 0.) {
+      state.smoothedCovariance().row(Acts::eBoundTheta) *= -1.;
+      state.smoothedCovariance().col(Acts::eBoundTheta) *= -1.;
+    }
+  }
+  Acts::Result<void> operator()(const Acts::GeometryContext&,
+      Acts::VectorMultiTrajectory& trajectory, std::size_t entryIndex,
+      const Acts::Logger& logger) const {
+    using Proxy = Acts::VectorMultiTrajectory::TrackStateProxy;
+    Acts::GainMatrixSmoother native;
+    Acts::GainMatrixSmoother::GetParameters filtered, smoothed, predicted;
+    Acts::GainMatrixSmoother::GetCovariance filteredCovariance,
+        predictedCovariance, smoothedCovariance, jacobian;
+    filtered.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->filtered();
+    });
+    smoothed.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->smoothed();
+    });
+    predicted.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->predicted();
+    });
+    filteredCovariance.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->filteredCovariance();
+    });
+    predictedCovariance.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->predictedCovariance();
+    });
+    smoothedCovariance.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->smoothedCovariance();
+    });
+    jacobian.connect([](const void*, void* state) {
+      return static_cast<Proxy*>(state)->jacobian();
+    });
+    auto previous = trajectory.getTrackState(entryIndex);
+    previous.smoothed() = previous.filtered();
+    previous.smoothedCovariance() = previous.filteredCovariance();
+    if (canonicalAngles) canonicalize(previous);
+    if (!previous.hasPrevious()) return Acts::Result<void>::success();
+    std::error_code error;
+    trajectory.applyBackwards(previous.previous(), [&](auto state) {
+      const double originalPhi = previous.smoothed()[Acts::eBoundPhi];
+      const double predictedPhi = previous.predicted()[Acts::eBoundPhi];
+      // The temporary 2*pi shift leaves the previous state's direction and
+      // covariance unchanged. Restore its stored chart after the native call.
+      if (wrapPhi) {
+        previous.smoothed()[Acts::eBoundPhi] = predictedPhi +
+            Acts::detail::difference_periodic(originalPhi, predictedPhi,
+                                               2. * std::acos(-1.));
+      }
+      auto status = native.calculate(&state, &previous, filtered,
+          filteredCovariance, smoothed, predicted, predictedCovariance,
+          smoothedCovariance, jacobian, logger);
+      previous.smoothed()[Acts::eBoundPhi] = originalPhi;
+      if (!status.ok()) {
+        error = status.error();
+        return false;
+      }
+      if (canonicalAngles) canonicalize(state);
+      previous = state;
+      return true;
+    });
+    return error ? Acts::Result<void>::failure(error)
+                 : Acts::Result<void>::success();
+  }
+};
 

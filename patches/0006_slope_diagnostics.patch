+// S05 opt-in observer. Reconstruction and propagation use the native Calypso tools.
+#include "AthenaBaseComps/AthAlgorithm.h"
+#include "StoreGate/ReadHandleKey.h"
+#include "StoreGate/ReadHandle.h"

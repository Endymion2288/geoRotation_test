+DECLARE_COMPONENT(CalypsoSlopeDiagnosticsAlg)
+
+// Separate propagation-only algorithm for archived native states and free
+// direction checks. It calls the same Calypso extrapolation tool as NtupleDumper.
+class CalypsoSlopeTransportProbeAlg final : public AthAlgorithm {
+public:
+  CalypsoSlopeTransportProbeAlg(const std::string& name,ISvcLocator* locator):AthAlgorithm(name,locator) {}
+  StatusCode initialize() override;
+  StatusCode execute() override;
+  StatusCode finalize() override;
+private:
+  ToolHandle<IFaserActsExtrapolationTool> m_tool{this,"ExtrapolationTool","FaserActsExtrapolationTool"};
+  SG::ReadHandleKey<FaserSiHitCollection> m_hits{this,"SiHits","SCT_Hits"};
+  Gaudi::Property<bool> m_rotated{this,"Rotated",true},m_scan{this,"DirectionScan",false};
+  Gaudi::Property<long> m_skip{this,"Skip",0};
+  Gaudi::Property<std::string> m_input{this,"InputStates",""},m_output{this,"Output","transport_probe.root"};
+  const FaserSCT_ID* m_ids=nullptr;
+  const TrackerDD::SCT_DetectorManager* m_manager=nullptr;
+  std::unique_ptr<TFile> m_file;
+  TTree* m_tree=nullptr;
+  long m_entry=0;
+  int m_seed=0,m_candidate=0,m_barcode=0,m_stage=0,m_layer=0,m_hasCov=0;
+  unsigned long long m_geometryID=0;
+  double m_inputPosition[3]{},m_inputMomentum[3]{},m_inputAngles[2]{},m_charge=0;
+  double m_outputParameters[3][6]{},m_outputCovariance[3][6][6]{};
+  int m_valid[3]{};
+  struct Input {int seed,candidate,barcode,stage,layer,kind;unsigned long long geometry;double charge;Acts::BoundVector values;};
+  std::map<long,std::vector<Input>> m_inputs;
+  Acts::Vector3 toF(const Acts::Vector3& x) const {return m_rotated ? Acts::Vector3(-x.z(),x.y(),x.x()) : x;}
+  Acts::Vector3 toNative(const Acts::Vector3& x) const {return m_rotated ? Acts::Vector3(x.z(),x.y(),-x.x()) : x;}
+  std::shared_ptr<Acts::PlaneSurface> plane(double z) const {
+    Acts::RotationMatrix3 basis=Acts::RotationMatrix3::Identity();
+    if(m_rotated) {basis.col(0)=Acts::Vector3(0,-1,0);basis.col(1)=Acts::Vector3(0,0,-1);basis.col(2)=Acts::Vector3(1,0,0);}
+    return Acts::Surface::makeShared<Acts::PlaneSurface>(Acts::Transform3(Acts::Translation3(toNative(Acts::Vector3(0,0,z)))*basis));
+  }
+  void propagate(const EventContext&,const Acts::GeometryContext&,const Acts::BoundTrackParameters&,const std::array<double,3>&);
+};
+
+StatusCode CalypsoSlopeTransportProbeAlg::initialize() {
+  ATH_CHECK(m_hits.initialize());ATH_CHECK(m_tool.retrieve());
+  ATH_CHECK(detStore()->retrieve(m_ids,"FaserSCT_ID"));ATH_CHECK(detStore()->retrieve(m_manager,"SCT"));
+  if(!m_input.value().empty()) {
+    std::ifstream file(m_input.value());if(!file) return StatusCode::FAILURE;
+    long entry;Input row;
+    while(file>>entry>>row.seed>>row.candidate>>row.barcode>>row.stage>>row.layer>>row.kind>>row.geometry>>row.charge) {
+      for(int i=0;i<6;++i) if(!(file>>row.values[i])) return StatusCode::FAILURE;
+      m_inputs[entry].push_back(row);
+    }
+    if(!file.eof()) return StatusCode::FAILURE;
+  }
+  m_file.reset(TFile::Open(m_output.value().c_str(),"RECREATE"));
+  if(!m_file || m_file->IsZombie()) return StatusCode::FAILURE;
+  m_tree=new TTree("transport","Actual Calypso propagation of native stages or physical direction scan");
+  m_tree->Branch("source_entry",&m_entry,"source_entry/L");
+  m_tree->Branch("seed",&m_seed,"seed/I");m_tree->Branch("candidate",&m_candidate,"candidate/I");
+  m_tree->Branch("barcode",&m_barcode,"barcode/I");m_tree->Branch("stage",&m_stage,"stage/I");
+  m_tree->Branch("layer",&m_layer,"layer/I");m_tree->Branch("geometry_id",&m_geometryID,"geometry_id/l");
+  m_tree->Branch("input_position_F_mm",m_inputPosition,"input_position_F_mm[3]/D");
+  m_tree->Branch("input_momentum_F_GeV",m_inputMomentum,"input_momentum_F_GeV[3]/D");
+  m_tree->Branch("input_angles_native",m_inputAngles,"input_angles_native[2]/D");
+  m_tree->Branch("input_has_covariance",&m_hasCov,"input_has_covariance/I");
+  m_tree->Branch("charge",&m_charge,"charge/D");
+  m_tree->Branch("projection_F",m_outputParameters,"projection_F[3][6]/D");
+  m_tree->Branch("projection_covariance_native",m_outputCovariance,"projection_covariance_native[3][6][6]/D");
+  m_tree->Branch("projection_valid",m_valid,"projection_valid[3]/I");
+  m_entry=m_skip;return StatusCode::SUCCESS;
+}
+
+void CalypsoSlopeTransportProbeAlg::propagate(const EventContext& ctx,const Acts::GeometryContext& gctx,
+    const Acts::BoundTrackParameters& start,const std::array<double,3>& targets) {
+  const auto pos=toF(start.position(gctx)),mom=toF(start.momentum());
+  for(int j=0;j<3;++j) {m_inputPosition[j]=pos[j];m_inputMomentum[j]=mom[j];}
+  m_inputAngles[0]=start.parameters()[2];m_inputAngles[1]=start.parameters()[3];
+  m_hasCov=start.covariance().has_value();m_charge=start.charge();
+  for(int i=0;i<3;++i) {
+    m_valid[i]=0;
+    for(double& v:m_outputParameters[i]) v=NAN;
+    for(auto& row:m_outputCovariance[i]) for(double& v:row) v=NAN;
+    if(!std::isfinite(targets[i])) {m_valid[i]=-1;continue;}
+    auto target=plane(targets[i]);
+    const auto direction=targets[i]>=pos.z() ? Acts::Direction::Forward : Acts::Direction::Backward;
+    auto result=m_tool->propagate(ctx,start,*target,direction);
+    if(!result) continue;
+    const auto x=toF(result->position(gctx)),p=toF(result->momentum());
+    for(int j=0;j<3;++j) {m_outputParameters[i][j]=x[j];m_outputParameters[i][j+3]=p[j];}
+    if(result->covariance()) for(int j=0;j<6;++j) for(int k=0;k<6;++k) m_outputCovariance[i][j][k]=(*result->covariance())(j,k);
+    m_valid[i]=1;
+  }
+  m_tree->Fill();
+}
+
+StatusCode CalypsoSlopeTransportProbeAlg::execute() {
+  const auto& ctx=Gaudi::Hive::currentContext();
+  auto holder=m_tool->trackingGeometryTool()->getNominalGeometryContext();auto gctx=holder.context();
+  if(m_scan && m_entry==m_skip.value()) {
+    m_seed=m_candidate=m_barcode=0;m_stage=-1;m_layer=-1;m_geometryID=0;
+    const std::array<double,7> slopes{-.003,-1e-6,-1e-9,0.,1e-9,1e-6,.003};
+    for(double p:{50.,100.,1000.}) for(double charge:{-1.,1.}) for(double sx:slopes) for(double sy:slopes) {
+      auto surface=plane(0.);
+      const auto direction=toNative(Acts::Vector3(sx,sy,1.).normalized());
+      Acts::BoundVector pars=Acts::BoundVector::Zero();
+      pars[2]=Acts::VectorHelpers::phi(direction);pars[3]=Acts::VectorHelpers::theta(direction);pars[4]=charge/p;
+      // At the F-frame pole phi is undefined; test its mean without pretending
+      // that a nonsingular angular covariance exists there.
+      std::optional<Acts::BoundSquareMatrix> cov;
+      const double r=std::hypot(sx,sy);
+      if(m_rotated || r>1e-12) {
+        cov=Acts::BoundSquareMatrix::Identity();cov->block<2,2>(2,2).setZero();
+        Eigen::Matrix2d jac;
+        if(m_rotated) {
+          jac(0,0)=0.;jac(0,1)=1./(1.+sy*sy);
+          const double a=std::sqrt(1.+sy*sy),b=1.+sx*sx+sy*sy;
+          jac(1,0)=a/b;jac(1,1)=-sx*sy/(a*b);
+        } else {
+          jac(0,0)=-sy/(r*r);jac(0,1)=sx/(r*r);
+          jac(1,0)=sx/(r*(1.+r*r));jac(1,1)=sy/(r*(1.+r*r));
+        }
+        const double sigma=std::min(1e-5,.01*std::max(r,1e-12));
+        cov->block<2,2>(2,2)=sigma*sigma*jac*jac.transpose();(*cov)(4,4)=1e-8/(p*p);
+      }
+      Acts::BoundTrackParameters start(std::move(surface),pars,cov,Acts::ParticleHypothesis::muon());
+      propagate(ctx,gctx,start,{100.,-100.,NAN});++m_candidate;
+    }
+  }
+  auto found=m_inputs.find(m_entry);
+  if(found!=m_inputs.end()) {
+    SG::ReadHandle<FaserSiHitCollection> hits(m_hits,ctx);ATH_CHECK(hits.isValid());
+    std::map<int,double> first;
+    for(const auto& hit:*hits) if(hit.getStation()==1) {
+      auto* element=m_manager->getDetectorElement(m_ids->wafer_id(1,hit.getPlane(),hit.getRow(),hit.getModule(),hit.getSensor()));
+      const auto a=hit.localStartPosition(),b=hit.localEndPosition();
+      const double z=(element->transformHit()*Acts::Vector3(.5*(a.x()+b.x()),.5*(a.y()+b.y()),.5*(a.z()+b.z()))).z();
+      auto [it,inserted]=first.emplace(hit.trackNumber(),z);if(!inserted && z<it->second) it->second=z;
+    }
+    auto tracking=m_tool->trackingGeometryTool()->trackingGeometry();
+    for(const auto& row:found->second) {
+      m_seed=row.seed;m_candidate=row.candidate;m_barcode=row.barcode;m_stage=row.stage;m_layer=row.layer;m_geometryID=row.geometry;
+      std::shared_ptr<const Acts::Surface> surface;Acts::BoundVector pars=row.values;
+      if(row.kind==1) {
+        const auto* s=tracking->findSurface(Acts::GeometryIdentifier(row.geometry));
+        if(!s) {ATH_MSG_ERROR("Archived state surface not found: "<<row.geometry);return StatusCode::FAILURE;}
+        surface=s->getSharedPtr();
+      } else {
+        const Acts::Vector3 pos=row.values.head<3>(),mom=row.values.tail<3>();
+        surface=plane(toF(pos).z());pars.setZero();pars.head<2>()=surface->globalToLocal(gctx,pos,mom.normalized()).value();
+        pars[2]=Acts::VectorHelpers::phi(mom);pars[3]=Acts::VectorHelpers::theta(mom);pars[4]=row.charge/mom.norm();
+      }
+      Acts::BoundTrackParameters start(std::move(surface),pars,std::nullopt,Acts::ParticleHypothesis::muon());
+      propagate(ctx,gctx,start,{0.,-3112.,first.count(row.barcode) ? first.at(row.barcode) : NAN});
+    }
+  }
+  ++m_entry;return StatusCode::SUCCESS;
+}
+
+StatusCode CalypsoSlopeTransportProbeAlg::finalize() {
+  m_file->cd();m_file->Write();const bool failed=m_file->TestBit(TFile::kWriteError);m_file->Close();
+  return failed ? StatusCode::FAILURE : StatusCode::SUCCESS;
+}
+
+DECLARE_COMPONENT(CalypsoSlopeTransportProbeAlg)

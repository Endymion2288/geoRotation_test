+void CircleFitTrackSeedTool::evaluateStripFieldFit(
+    Seed& seed,
+    const Acts::GeometryContext& gctx,
+    const std::map<Identifier, Acts::GeometryIdentifier>& idMap) const {
+  seed.hasStripFit = false;
+  seed.stripChi2 = std::numeric_limits<double>::quiet_NaN();
+  seed.stripNdf = 0;
+  if (!m_fieldProfile.initialized || seed.clusters.size() < 6 || seed.stations < 2) return;
+  const auto trackingGeometry = m_trackingGeometryTool->trackingGeometry();
+  if (!trackingGeometry) return;
+
+  struct RowObs {
+    Eigen::Matrix<double, 1, 5> h;
+    double b;
+    double w;
+  };
+  std::vector<RowObs> rows;
+  rows.reserve(seed.clusters.size());
+
+  // Map station -> segment approximate ACTS transverse position (y_A = y_F, z_A = -x_F)
+  std::array<Acts::Vector2, 4> stApproxYZ{
+      Acts::Vector2::Zero(), Acts::Vector2::Zero(), Acts::Vector2::Zero(), Acts::Vector2::Zero()};
+  for (const auto& seg : seed.segs) {
+    if (seg.station >= 0 && seg.station < 4) {
+      stApproxYZ[seg.station] = Acts::Vector2(seg.position.y(), -seg.position.x());
+    }
+  }
+
+  Eigen::Matrix<double, 5, 5> AtWA = Eigen::Matrix<double, 5, 5>::Zero();
+  Eigen::Matrix<double, 5, 1> AtWb = Eigen::Matrix<double, 5, 1>::Zero();
+
+  for (const auto* cl : seed.clusters) {
+    if (!cl || !cl->detectorElement()) continue;
+    const Identifier waferId = cl->detectorElement()->identify();
+    auto git = idMap.find(waferId);
+    if (git == idMap.end()) continue;
+    const Acts::Surface* surf = trackingGeometry->findSurface(git->second);
+    if (!surf) continue;
+
+    const auto& tf = surf->transform(gctx);
+    const Acts::Vector3 C = tf.translation();
+    const Acts::Vector3 e0 = tf.rotation().col(0);
+    const Acts::Vector3 e2 = tf.rotation().col(2);
+    const int st = m_idHelper->station(waferId);
+    const Acts::Vector2 yzApprox = (st >= 0 && st < 4) ? stApproxYZ[st] : Acts::Vector2(C.y(), C.z());
+
+    double xW = C.x();
+    if (std::abs(e2.x()) > 0.5) {
+      xW = C.x() - (e2.y() * (yzApprox[0] - C.y()) + e2.z() * (yzApprox[1] - C.z())) / e2.x();
+    }
+    double jy = 0.0, iy = 0.0, jz = 0.0, iz = 0.0;
+    m_fieldProfile.eval(xW, jy, iy, jz, iz);
+
+    Eigen::Matrix<double, 1, 5> h;
+    h << e0.y(), e0.y() * xW, e0.z(), e0.z() * xW, (e0.y() * iy + e0.z() * iz);
+    const double uMeas = cl->localPosition().x();
+    const double constTerm = e0.x() * (xW - C.x()) - e0.y() * C.y() - e0.z() * C.z();
+    const double bVal = uMeas - constTerm;
+    const double msExtra = (st == 2) ? (0.012 * 0.012) : ((st == 3) ? (0.020 * 0.020) : 0.0);
+    const double w = 1.0 / (0.0231 * 0.0231 + msExtra);
+
+    AtWA.noalias() += w * (h.transpose() * h);
+    AtWb.noalias() += w * h.transpose() * bVal;
+    rows.push_back({h, bVal, w});
+  }
+
+  if (rows.size() < 6) return;
+  Eigen::LDLT<Eigen::Matrix<double, 5, 5>> ldlt(AtWA);
+  if (ldlt.info() != Eigen::Success) return;
+  const Eigen::Matrix<double, 5, 1> theta = ldlt.solve(AtWb);
+  if (!theta.allFinite()) return;
+
+  double chi2Sum = 0.0;
+  for (const auto& r : rows) {
+    const double res = (r.h * theta)(0, 0) - r.b;
+    chi2Sum += r.w * res * res;
+  }
+  if (!std::isfinite(chi2Sum)) return;
+
+  seed.hasStripFit = true;
+  seed.stripTheta = theta;
+  seed.stripChi2 = chi2Sum;
+  seed.stripNdf = rows.size() - 5;
+}

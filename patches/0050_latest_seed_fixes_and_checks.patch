+void CircleFitTrackSeedTool::FieldProfileGrid::eval(
+    double xA, double& jy, double& iy, double& jz, double& iz) const {
+  if (!initialized || Jy.empty()) {
+    jy = iy = jz = iz = 0.0;
+    return;
+  }
+  const double u = (xA - xMin) / dx;
+  if (u <= 0.0) {
+    jy = Jy.front();
+    iy = Iy.front() + jy * (xA - xMin);
+    jz = Jz.front();
+    iz = Iz.front() + jz * (xA - xMin);
+    return;
+  }
+  const size_t maxIdx = Jy.size() - 1;
+  if (u >= static_cast<double>(maxIdx)) {
+    const double xEnd = xMin + dx * static_cast<double>(maxIdx);
+    jy = Jy.back();
+    iy = Iy.back() + jy * (xA - xEnd);
+    jz = Jz.back();
+    iz = Iz.back() + jz * (xA - xEnd);
+    return;
+  }
+  const size_t i0 = static_cast<size_t>(u);
+  const double f = u - static_cast<double>(i0);
+  jy = Jy[i0] * (1.0 - f) + Jy[i0 + 1] * f;
+  iy = Iy[i0] * (1.0 - f) + Iy[i0 + 1] * f;
+  jz = Jz[i0] * (1.0 - f) + Jz[i0 + 1] * f;
+  iz = Iz[i0] * (1.0 - f) + Iz[i0 + 1] * f;
+}
+
+void CircleFitTrackSeedTool::ensureFieldProfile(const EventContext& ctx) {
+  if (m_fieldProfile.initialized) return;
+  SG::ReadCondHandle<FaserFieldCacheCondObj> readHandle{m_fieldCondObjInputKey, ctx};
+  if (!readHandle.isValid()) return;
+  const FaserFieldCacheCondObj* fieldCondObj{*readHandle};
+  Acts::MagneticFieldContext mfCtx(fieldCondObj);
+  FASERMagneticFieldWrapper wrapper;
+  auto cache = wrapper.makeCache(mfCtx);
+
+  const double xMin = -200.0, xMax = 2600.0, dx = 1.0;
+  const size_t nPts = static_cast<size_t>((xMax - xMin) / dx) + 1;
+  m_fieldProfile.xMin = xMin;
+  m_fieldProfile.dx = dx;
+  m_fieldProfile.Jy.assign(nPts, 0.0);
+  m_fieldProfile.Iy.assign(nPts, 0.0);
+  m_fieldProfile.Jz.assign(nPts, 0.0);
+  m_fieldProfile.Iz.assign(nPts, 0.0);
+
+  std::vector<double> ay(nPts, 0.0), az(nPts, 0.0);
+  for (size_t i = 0; i < nPts; ++i) {
+    const double xA = xMin + dx * static_cast<double>(i);
+    auto bRes = wrapper.getField(Acts::Vector3(xA, 0.0, 0.0), cache);
+    if (bRes.ok()) {
+      // du/dx_A = (q/p) * (u x B_A); for u=(1,0,0), (u x B)_y = -B_zA, (u x B)_z = +B_yA
+      ay[i] = -bRes.value().z();
+      az[i] = +bRes.value().y();
+    }
+  }
+  const size_t iZero = static_cast<size_t>((0.0 - xMin) / dx);
+  for (size_t i = iZero + 1; i < nPts; ++i) {
+    m_fieldProfile.Jy[i] = m_fieldProfile.Jy[i - 1] + 0.5 * (ay[i - 1] + ay[i]) * dx;
+    m_fieldProfile.Iy[i] = m_fieldProfile.Iy[i - 1] + 0.5 * (m_fieldProfile.Jy[i - 1] + m_fieldProfile.Jy[i]) * dx;
+    m_fieldProfile.Jz[i] = m_fieldProfile.Jz[i - 1] + 0.5 * (az[i - 1] + az[i]) * dx;
+    m_fieldProfile.Iz[i] = m_fieldProfile.Iz[i - 1] + 0.5 * (m_fieldProfile.Jz[i - 1] + m_fieldProfile.Jz[i]) * dx;
+  }
+  for (size_t i = iZero; i > 0; --i) {
+    m_fieldProfile.Jy[i - 1] = m_fieldProfile.Jy[i] - 0.5 * (ay[i - 1] + ay[i]) * dx;
+    m_fieldProfile.Iy[i - 1] = m_fieldProfile.Iy[i] - 0.5 * (m_fieldProfile.Jy[i - 1] + m_fieldProfile.Jy[i]) * dx;
+    m_fieldProfile.Jz[i - 1] = m_fieldProfile.Jz[i] - 0.5 * (az[i - 1] + az[i]) * dx;
+    m_fieldProfile.Iz[i - 1] = m_fieldProfile.Iz[i] - 0.5 * (m_fieldProfile.Jz[i - 1] + m_fieldProfile.Jz[i]) * dx;
+  }
+  m_fieldProfile.initialized = true;
+}

+bool CircleFitTrackSeedTool::passPreFilter(const std::vector<Segment>& comb) const {
+  if (comb.size() >= 2) {
+    const auto& a = comb[comb.size() - 2];
+    const auto& b = comb[comb.size() - 1];
+    const double dz = b.position.z() - a.position.z();
+    if (std::abs(dz) > 200.0) {
+      const double txChord = (b.position.x() - a.position.x()) / dz;
+      if (std::abs(txChord) > 0.12) return false;
+      if (std::abs(a.momentum.z()) > 1e-6 && std::abs(b.momentum.z()) > 1e-6) {
+        const double txA = a.momentum.x() / a.momentum.z();
+        const double txB = b.momentum.x() / b.momentum.z();
+        if (std::abs(txA - txChord) > 0.045 || std::abs(txB - txChord) > 0.045) return false;
+      }
+    }
+  }
+  if (comb.size() >= 3) {
+    const auto& s0 = comb.front();
+    const auto& s1 = comb[1];
+    const auto& s2 = comb.back();
+    const double dz02 = s2.position.z() - s0.position.z();
+    if (std::abs(dz02) > 500.0) {
+      const double xInterp = s0.position.x() +
